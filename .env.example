# The edge service talks to LiteLLM with a scoped virtual key.
LLM_GATEWAY_API_KEY=replace-with-a-litellm-virtual-key
LLM_GATEWAY_BASE_URL=http://localhost:4000/v1
DEFAULT_MODEL_ALIAS=balanced
ALLOWED_MODEL_ALIASES=fast,balanced,reasoning,private
WRAPPER_API_KEYS=local-development-key
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=2
WEBHOOK_SIGNING_SECRET=replace-with-a-long-random-secret
WEBHOOK_ALLOW_HTTP=false
MAX_INPUT_CHARACTERS=100000
MAX_OUTPUT_TOKENS=8192

# Provider credentials are read by LiteLLM, never sent to gateway clients.
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_API_BASE=http://host.docker.internal:11434
LITELLM_MASTER_KEY=replace-with-a-long-random-secret
LITELLM_SALT_KEY=replace-with-another-long-random-secret
DATABASE_URL=postgresql://litellm:litellm@postgres:5432/litellm
POSTGRES_PASSWORD=replace-with-a-database-password
REDIS_HOST=redis
GUARDRAIL_MODE=block
GUARDRAIL_POLICY_VERSION=2026-08-17
GUARDRAIL_AUDIT_KEY=replace-with-secret-manager-value
